# ==============================================================================
# 🔒 ENVIRONMENT CONFIGURATION TEMPLATE (TRACK 4)
# ==============================================================================
# Copy this file to .env and fill in your local or production database credentials.
# NEVER commit the real .env file to Git!
# ==============================================================================

# Option B: Containerized PostgreSQL (Local default)
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=taskflow

# Option B Alternative: Cloud PostgreSQL (e.g. Supabase / Neon)
# Style A: Single Connection URI
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Style B: Separate Entry Points
# POSTGRES_HOST=aws-0-[REGION].pooler.supabase.com
# POSTGRES_PORT=6543
# POSTGRES_USER=postgres.[PROJECT-REF]
# POSTGRES_PASSWORD=your_cloud_password
# POSTGRES_DB=postgres
# POSTGRES_SSL=true

# Option C: Native Host MySQL (host.docker.internal)
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_local_mysql_password_here
MYSQL_DATABASE=simple_app
MYSQL_SSL=false

# Option C Alternative: Cloud Managed MySQL (e.g. Aiven / TiDB Cloud)
# Style A: Single Connection URI
# MYSQL_URL=mysql://avnadmin:your_cloud_password@mysql-xxxx.aivencloud.com:18320/defaultdb?ssl-mode=REQUIRED
# Style B: Separate Entry Points
# MYSQL_HOST=mysql-xxxx.aivencloud.com
# MYSQL_PORT=18320
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=your_cloud_mysql_password
# MYSQL_DATABASE=defaultdb
# MYSQL_SSL=true
