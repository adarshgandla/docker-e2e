# ==============================================================================
# 🐳 TASKFLOW (SINGLE CONTAINER) — ENVIRONMENT VARIABLES
# ==============================================================================
# In a single container, everything is self-contained.
# Database storage path and application port are configurable here.
# ==============================================================================

# Network Port to listen on (Default: 4000)
PORT=4000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Embedded SQLite Database directory:
# - Inside Container : /data (internal directory where SQLite writes 'tasks.db')
# - Host Physical Path: Mapped via Docker volume (-v taskflow_data:/data)
# - How to find on Host: Run 'docker volume inspect taskflow_data' -> see "Mountpoint"
DB_DIR=/data

