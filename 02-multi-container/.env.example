# ------------------------------------------------------------------------------
# SHARED SETTINGS
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
API_PORT=4000
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:4000
REDIS_PASSWORD=redispass456

# ==============================================================================
# MODE 1: LOCAL DATABASE (Active by default)
# ==============================================================================
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpass123
POSTGRES_DB=taskflow

# ==============================================================================
# MODE 2: CLOUD DATABASE (Supabase / Neon / RDS)
# Choose either Style A (Single URL) OR Style B (Separate fields):
# ==============================================================================
# Style A: Single Connection URI
# DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Style B: Separate Entry Points
# POSTGRES_HOST=aws-0-[REGION].pooler.supabase.com
# POSTGRES_PORT=6543
# POSTGRES_USER=postgres.[REF]
# POSTGRES_PASSWORD=your_cloud_password
# POSTGRES_DB=postgres
# POSTGRES_SSL=true
