# ==============================================================================
# 🐳 TASKFLOW TRACK 3 (HOST MYSQL BRIDGE) — ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# SHARED SETTINGS
# ------------------------------------------------------------------------------
PORT=4001
NODE_ENV=production

# ==============================================================================
# MODE 1: LOCAL HOST MYSQL (Active by default)
# ==============================================================================
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=simple_app
MYSQL_SSL=false

# ==============================================================================
# MODE 2: CLOUD MANAGED MYSQL (Aiven / TiDB Cloud / AWS RDS)
# Choose either Style A (Single URL) OR Style B (Separate fields):
# ==============================================================================
# Style A: Single Connection URI
# MYSQL_URL=mysql://avnadmin:your_cloud_password@mysql-xxxx.aivencloud.com:18320/defaultdb?ssl-mode=REQUIRED

# Style B: Separate Entry Points
# MYSQL_HOST=mysql-xxxx.aivencloud.com
# MYSQL_PORT=18320
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=your_cloud_password
# MYSQL_DATABASE=defaultdb
# MYSQL_SSL=true

