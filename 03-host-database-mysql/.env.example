# ==============================================================================
# 🐳 TASKFLOW TRACK 3 (HOST MYSQL BRIDGE) — ENVIRONMENT VARIABLES
# ==============================================================================

# Application Port (Host Port: 4001)
PORT=4001
NODE_ENV=production

# ------------------------------------------------------------------------------
# OPTION A: LOCAL HOST MYSQL (Track 3 Default)
# ------------------------------------------------------------------------------
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=simple_app
MYSQL_SSL=false

# ------------------------------------------------------------------------------
# OPTION B: CLOUD MANAGED MYSQL (e.g. Aiven / TiDB Cloud / AWS RDS)
# ------------------------------------------------------------------------------
# MYSQL_HOST=mysql-xxxx-your-project.aivencloud.com
# MYSQL_PORT=18320
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=your_aiven_password
# MYSQL_DATABASE=defaultdb
# MYSQL_SSL=true

