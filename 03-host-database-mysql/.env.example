# ==============================================================================
# 🐳 TASKFLOW TRACK 3 (HOST MYSQL BRIDGE) — ENVIRONMENT VARIABLES
# ==============================================================================

# Application Port (Host Port: 4001)
PORT=4001
NODE_ENV=production

# Host Database Connection
# Inside Docker on Windows/Mac: host.docker.internal
# Inside Docker on Linux: host.docker.internal (enabled via extra_hosts in compose)
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=taskflow
